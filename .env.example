# Email notifications (optional). Set RESEND_API_KEY to get an email for every
# submission; without it, submissions are stored in data/submissions.jsonl.
# https://resend.com
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Mahedi Tech <onboarding@resend.dev>"
CONTACT_TO_EMAIL=hello@atomiclabs.space

# Where contact submissions are stored (defaults to ./data)
# On serverless platforms, point this at a persistent volume or /tmp.
DATA_DIR=
